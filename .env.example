# Copia este archivo a .env y completa los valores de tu proyecto de Supabase.
# Estas dos variables son públicas: viajan al navegador. La anon key solo tiene
# permiso de LECTURA sobre puntos aprobados (ver supabase/migrations/0002_rls.sql).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: captcha invisible de Cloudflare Turnstile en los formularios.
# Si se deja vacío, la app funciona igual con las defensas básicas
# (honeypot, tiempo mínimo de llenado y límite por IP en la Edge Function).
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Los siguientes NO van en este archivo ni en el repositorio.
# Se configuran como secretos de las Edge Functions:
#
#   npx supabase secrets set MODERATOR_KEY=...
#   npx supabase secrets set IP_HASH_SALT=...
#   npx supabase secrets set TURNSTILE_SECRET=...
# ---------------------------------------------------------------------------
